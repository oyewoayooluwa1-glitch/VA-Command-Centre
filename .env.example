# Copy to .env.local for local dev. In production these are set as
# Cloudflare Worker secrets/vars (see README), never committed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Admin-only. On Supabase's API Keys page this is the "secret key" (the
# replacement for the old "service_role" key) — NOT the publishable key
# above. Bypasses every RLS policy. Set as a Cloudflare SECRET
# (wrangler secret put SUPABASE_SERVICE_ROLE_KEY), never a Build variable,
# and never with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Paystack. Secret key is from your Paystack dashboard (Settings → API
# Keys & Webhooks) — set as a Cloudflare SECRET, same rules as above.
# The three PAYSTACK_PLAN_* values come from creating three recurring
# Plans in Paystack (Products → Plans) at ₦7,500 / ₦10,000 / ₦15,000 per
# month — each gives you a plan code (starts with PLN_) to paste here.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PLAN_BASIC=PLN_xxxxxxxx
PAYSTACK_PLAN_ADVANCED=PLN_xxxxxxxx
PAYSTACK_PLAN_PROFESSIONAL=PLN_xxxxxxxx

# Your live app URL, used as the redirect target after Paystack checkout.
NEXT_PUBLIC_APP_URL=https://your-app.workers.dev
